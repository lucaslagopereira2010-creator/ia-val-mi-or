# ============================================================
# Variables de entorno del backend (modo avanzado con la API de Claude)
# Copia este archivo como ".env" y rellena los valores.
# El archivo .env NUNCA debe subirse al repositorio (ya está en .gitignore).
# ============================================================

# Clave de la API de Claude. Consíguela en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-tu-clave-aqui

# (Opcional) Dominio permitido para llamar al backend (CORS).
# Recomendado fijarlo al dominio de la web del club en producción.
ALLOWED_ORIGIN=https://www.edvmnigran.com

# (Opcional) Modelo a utilizar. Por defecto: claude-opus-4-8 (el más capaz).
# Para reducir coste en alto volumen puedes usar uno más económico:
# EDVM_MODELO=claude-haiku-4-5
